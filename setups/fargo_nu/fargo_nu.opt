# You may enter a description between the BEGIN and END labels.
# BEGIN
# The "fargo_nu" setup is similar to the setup fargo but on a non-uniform mesh generated
# via a mesh density function. It also utilizes the RAM method.
# In order to run it, do:
# make SETUP=fargo_nu
# fargo3d setups/fargo_nu/fargo_nu.par
# END
#-------------------------------------------------------------------------

# Fluids
FLUIDS := 0
NFLUIDS = 1
FARGO_OPT += -DNFLUIDS=${NFLUIDS}

#Monitoring
MONITOR_SCALAR = MASS | MOM_X | TORQ
MONITOR_Y_RAW  = TORQ

# Dimensions
FARGO_OPT +=  -DX
FARGO_OPT +=  -DY

# Geometry
FARGO_OPT += -DCYLINDRICAL

# Physics
FARGO_OPT += -DISOTHERMAL
FARGO_OPT += -DPOTENTIAL # activates gravity
FARGO_OPT += -DVISCOSITY # activates constant kinematic viscosity (NU)
# FARGO_OPT += -DALPHAVISCOSITY # activates Shakura-Sunyaev viscosity

# Buffer zones
FARGO_OPT += -DSTOCKHOLM # activates wave-killing in Y and Z
# FARGO_OPT += -DRAM # enables a faster advection algorithm

# Cuda blocks
ifeq (${GPU}, 1)
FARGO_OPT += -DBLOCK_X=16
FARGO_OPT += -DBLOCK_Y=16
FARGO_OPT += -DBLOCK_Z=1
endif
